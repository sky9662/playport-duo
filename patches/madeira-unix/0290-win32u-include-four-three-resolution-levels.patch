From dfd2d5302d60a7b0f05cb2cf0a4745bdfcfbaa98 Mon Sep 17 00:00:00 2001
From: Playport fork <local@example.invalid>
Date: Mon, 9 Nov 2026 14:18:03 +0800
Subject: [PATCH] win32u: include 4:3 modes for selected resolution levels

Keep the configured desktop and game-selected current mode distinct.
Expose 720x540, 960x720 and larger 4:3 sizes when they fit the desktop.

Class: ios-port
Evidence: tools/tests/test_display_modes.py
Offered-upstream: no; iOS virtual monitor modes
---
 build/win32u-unix/pp_display_modes.h | 36 ++++++++++++++++++++++++++++
 build/win32u-unix/sysparams_ios.c    | 31 ++++--------------------
 2 files changed, 41 insertions(+), 26 deletions(-)
 create mode 100644 build/win32u-unix/pp_display_modes.h

diff --git a/build/win32u-unix/pp_display_modes.h b/build/win32u-unix/pp_display_modes.h
new file mode 100644
index 0000000..aad32db
--- /dev/null
+++ b/build/win32u-unix/pp_display_modes.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Virtual monitor mode enumeration, independent of UIKit and Wine types.
+ * Native means the configured desktop, never an inferred 4:3 panel.
+ */
+#ifndef PP_DISPLAY_MODES_H
+#define PP_DISPLAY_MODES_H
+struct pp_display_size { int width, height; };
+static unsigned pp_display_modes( struct pp_display_size *sizes, unsigned max, int sw, int sh )
+{
+    static const struct pp_display_size common[] = {
+        {640,480}, {800,600}, {720,540}, {960,720}, {1024,768}, {1152,864},
+        {1280,960}, {1440,1080}, {1600,1200}, {1920,1440},
+        {960,540}, {1280,720}, {1600,900}, {1920,1080}, {2560,1440},
+        {1440,900}, {1680,1050}, {1920,1200}, {1280,1024}, {1280,768}
+    };
+    unsigned count = 0, i, j, common_count = sizeof(common) / sizeof(common[0]);
+    if (sw <= 0 || sh <= 0) return 0;
+    for (i = 0; i <= common_count && count < max; i++)
+    {
+        struct pp_display_size size = i < common_count ? common[i] : (struct pp_display_size){sw,sh};
+        if (i >= 2 && i < common_count && (size.width > sw || size.height > sh)) continue;
+        for (j = 0; j < count; j++)
+            if (sizes[j].width == size.width && sizes[j].height == size.height) break;
+        if (j < count) continue;
+        for (j = count; j > 0; j--)
+        {
+            if (sizes[j-1].width < size.width ||
+                (sizes[j-1].width == size.width && sizes[j-1].height < size.height)) break;
+            sizes[j] = sizes[j-1];
+        }
+        sizes[j] = size;
+        count++;
+    }
+    return count;
+}
+#endif
diff --git a/build/win32u-unix/sysparams_ios.c b/build/win32u-unix/sysparams_ios.c
index 94a4c39..eebb886 100644
--- a/build/win32u-unix/sysparams_ios.c
+++ b/build/win32u-unix/sysparams_ios.c
@@ -4075,36 +4075,15 @@ static const UINT ios_virtual_depths[] = {32, 16, 8};
  * 640x480 and 800x600 always (the list this replaces had them), the common
  * sizes of Wine's mode emulation that fit in the native size, and the native
  * size. Returns how many were written to sizes (at most max). */
+#include "pp_display_modes.h"
 static UINT ios_virtual_sizes( SIZE *sizes, UINT max )
 {
-    static const SIZE common[] =
-    {
-        { 640,  480}, { 800,  600}, {1024,  768}, {1152,  864}, {1280,  960}, {1600, 1200},
-        { 960,  540}, {1280,  720}, {1600,  900}, {1920, 1080}, {2560, 1440},
-        {1440,  900}, {1680, 1050}, {1920, 1200},
-        {1280, 1024}, {1280,  768},
-    };
-    UINT count = 0, i, j;
+    struct pp_display_size list[32];
+    unsigned count, i;
     int sw, sh;
-
     ios_screen_size( &sw, &sh );
-    for (i = 0; i <= ARRAY_SIZE(common) && count < max; i++)
-    {
-        SIZE size = i < ARRAY_SIZE(common) ? common[i] : (SIZE){sw, sh};
-        BOOL always = i < 2;
-
-        if (!always && i < ARRAY_SIZE(common) && (size.cx > sw || size.cy > sh)) continue;
-        for (j = 0; j < count; j++) if (sizes[j].cx == size.cx && sizes[j].cy == size.cy) break;
-        if (j < count) continue;
-        /* insert in order */
-        for (j = count; j > 0; j--)
-        {
-            if (sizes[j - 1].cx < size.cx || (sizes[j - 1].cx == size.cx && sizes[j - 1].cy < size.cy)) break;
-            sizes[j] = sizes[j - 1];
-        }
-        sizes[j] = size;
-        count++;
-    }
+    count = pp_display_modes( list, max < 32 ? max : 32, sw, sh );
+    for (i = 0; i < count; i++) { sizes[i].cx = list[i].width; sizes[i].cy = list[i].height; }
     return count;
 }
 
